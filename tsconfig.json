{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next-prod/dev/types/**/*.ts",
    ".next-mobile-qa/types/**/*.ts",
    ".next-mobile-qa/dev/types/**/*.ts",
    ".next-854/types/**/*.ts",
    ".next-854/dev/types/**/*.ts",
    ".next-shots/types/**/*.ts",
    ".next-shots/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "skills"
  ]
}
