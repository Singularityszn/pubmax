.next/
.next-*/
node_modules/
# `out/` is the static-export build directory. It also matches every source
# directory named `out`, so each one has to be un-ignored by hand or its files
# never reach a commit.
out/
!app/out/
!app/out/**
!app/api/out/
!app/api/out/**
!lib/out/
!lib/out/**
!components/out/
!components/out/**
dist/
.env*
!.env.example
*.log
*.tsbuildinfo
scripts/__pycache__/
.vercel
.context/
.firecrawl/
.tavily/
test-results/
playwright-report/
artifacts/
/coverage/
e2e/screenshots/
.e2e/
# public/vendor/ is BUILD-WRITTEN (lib/staticAssetPrefixes.mjs): prebuild copies
# the MapLibre worker modules out of node_modules, and the fence proves the
# prefix by that generator, so nothing under it may be committed.
public/vendor/maplibre/
data/generated/venue_detail_index.json
data/generated/venue_details.jsonl
public/data/wikidata_notable_pubs.json
public/data/wikidata_notable_pubs.json.tmp
data/editorial/poll-state.json
data/osm/uk/**/.*.tmp

# macOS Finder metadata + local co-dev scratch probes — never part of the app.
.DS_Store
scratch-*.mjs

# Local agent / skill / MCP tooling — never part of the app, machine-specific
.agents/*
!.agents/skills/
!.agents/skills/**
.claude-flow/
.cursor/*
!.cursor/mcp.json
# Cursor discovers project skills from .cursor/skills/ and .agents/skills/ only.
# skills/ is the browsable mirror; .cursor/skills/ symlinks to it; .agents/skills/ holds
# npx-skills project installs (Matt Pocock, Kenji, kunchenguid, last30days, …).
!.cursor/skills/
!.cursor/skills/**
.claude/
.mcp.json
.playwright-mcp/
skills-lock.json
skill_disabled.md
skill_del.md
skill_in_pub.md
skills_used_global.md
.data/
.firecrawl/

# Wave J — commit Taste/Emil skills under skills/ (not machine .agents/)
!skills/
!skills/**
.codex/
.lavish/
.codex-worktrees/

# clerk configuration (can include secrets)
/.clerk/

# UK venue Overpass working files: several hundred MB of raw responses that
# rebuild from `npm run fetch:uk-venues`. The normalized packs beside them are
# what a reader consumes and those ARE committed.
data/osm/uk/raw_venues/

# All-UK pub harvest working files (ODbL seed + Exa shards). The first 100
# seed rows are the committed sample; the rest rebuild from the harvest CLI.
data-harvest/*
!data-harvest/uk_pubs_seed.sample.jsonl

# GitNexus code-graph index. Machine-local, ~1 GB, and rebuilt by
# `gitnexus analyze`. The tool self-ignores with its own .gitnexus/.gitignore;
# this entry states the rule where a reader looks for it. Run flags are pinned
# in .gitnexusrc, which IS committed.
.gitnexus/

# Xcode derived data from `npm run ios:build` / `ios:run`. Build output, several
# hundred MB, and rebuilt by the script; ios/App and ios/App/CapApp-SPM ARE
# committed.
ios/build/

# Supabase CLI local state. `_current_branch` names whichever branch the CLI on
# THIS machine last linked and `cli-latest` is its own update check, so both
# rewrite themselves on ordinary use and neither is a change anybody made.
# The migrations, the rollbacks and config.toml ARE committed.
supabase/.branches/
supabase/.temp/

# Review dumps agents drop at the repository root. Each one is the output of a
# single review or check run, named the same way every time, so a stray copy
# lands in `git status` and reads as a change somebody made. None is an input
# to a build, a test or a deploy. The leading-space variant is a real filename
# some tools write.
review_result.json
 review_result.json
notes.md
*.review.json
PR_TITLE_AND_BODY.json
CHECK_SUMMARY.json
EXIT.json

# Playwright screenshots written by the Tonight trusted-UI specs. The specs
# create the directory themselves and overwrite every file on each run, so a
# committed copy is stale the moment the page changes.
e2e-shots/
