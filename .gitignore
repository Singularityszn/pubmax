.next/
.next-*/
# Next.js writes next-env.d.ts on every dev, build and typegen run, pointing it
# at the active dist dir, so it is never committed. `npm run typecheck` runs
# `next typegen` first to create it in a clean checkout.
next-env.d.ts
node_modules/
# `out/` is the static-export build directory. It also matches every source
# directory named `out`, so each one has to be un-ignored by hand or its files
# never reach a commit.
out/
!app/out/
!app/out/**
!app/api/out/
!app/api/out/**
!lib/out/
!lib/out/**
!components/out/
!components/out/**
dist/
.env*
!.env.example
*.env
*.log
!/docs/proof/skills-packages-2026-10-07/review-r5-r6/before-recipes.log
!/docs/proof/skills-packages-2026-10-07/review-r5-r6/after-recipes.log
!/docs/proof/skills-packages-2026-10-07/review-r5-r6/after-recipes-first-attempt.log
!/docs/proof/skills-packages-2026-10-07/review-r5-r6/browser.log
!/docs/proof/skills-packages-2026-10-07/review-r5-r6/browser-config-failure.log
!/docs/proof/skills-packages-2026-10-07/review-r5-r6/browser-cwd-failure.log
*.tsbuildinfo
scripts/__pycache__/
.vercel
.context/
.firecrawl/
.tavily/
test-results/
playwright-report/
evals/pal/scoreboard/
evals/askRouterModel/scoreboard/
artifacts/
.tmp-evidence/
/coverage/
/blob-reports/
e2e/screenshots/
.e2e/
# public/vendor/ is BUILD-WRITTEN (lib/staticAssetPrefixes.mjs): `npm run dev`
# and `npm run build` copy the MapLibre workers and the ElevenLabs AudioWorklets out of
# node_modules. The fence proves the prefix by that generator, so nothing
# under these directories may be committed.
public/vendor/maplibre/
public/vendor/elevenlabs/
data/generated/venue_detail_index.json
data/generated/venue_details.jsonl
public/data/wikidata_notable_pubs.json
public/data/wikidata_notable_pubs.json.tmp
public/data/.*.tmp
data/editorial/poll-state.json
data/osm/uk/**/.*.tmp
data/places_verification/progress.json
data/places_verification/uk_progress.json
data/places_verification/*.tmp

# macOS Finder metadata + local co-dev scratch probes — never part of the app.
.DS_Store
scratch-*.mjs

# Local agent / skill / MCP tooling — never part of the app, machine-specific
.agents/*
!.agents/skills/
!.agents/skills/**
.claude-flow/
.cursor/*
!.cursor/mcp.json
# Project skills live only under .agents/skills/. The machine-wide set is
# ~/.agents/skills. .cursor/skills/ is not a second project skill root.
.claude/
.mcp.json
.playwright-mcp/
skills-lock.json
skill_disabled.md
skill_del.md
skill_in_pub.md
skills_used_global.md
.data/
.firecrawl/

# The old browsable mirror at the repo root. Project skills are .agents/skills/
# (un-ignored above). The leading slash keeps this from matching that directory.
/skills/
.codex/
.lavish/
.codex-worktrees/

# clerk configuration (can include secrets)
/.clerk/

# UK venue Overpass working files: several hundred MB of raw responses that
# rebuild from `npm run fetch:uk-venues`. The normalized packs beside them are
# what a reader consumes and those ARE committed.
data/osm/uk/raw_venues/

# All-UK pub harvest working files (ODbL seed + Exa shards). The first 100
# seed rows are the committed sample; the rest rebuild from the harvest CLI.
data-harvest/*
!data-harvest/uk_pubs_seed.sample.jsonl

# GitNexus code-graph index. Machine-local, ~1 GB, and rebuilt by
# `gitnexus analyze`. The tool self-ignores with its own .gitnexus/.gitignore;
# this entry states the rule where a reader looks for it. Run flags are pinned
# in .gitnexusrc, which IS committed.
.gitnexus/

# Xcode derived data from `npm run ios:build` / `ios:run`. Build output, several
# hundred MB, and rebuilt by the script; ios/App and ios/App/CapApp-SPM ARE
# committed.
ios/build/

# Supabase CLI local state. `_current_branch` names whichever branch the CLI on
# THIS machine last linked and `cli-latest` is its own update check, so both
# rewrite themselves on ordinary use and neither is a change anybody made.
# The migrations, the rollbacks and config.toml ARE committed.
supabase/.branches/
supabase/.temp/

# Review dumps agents drop at the repository root. Each one is the output of a
# single review or check run, named the same way every time, so a stray copy
# lands in `git status` and reads as a change somebody made. None is an input
# to a build, a test or a deploy. The leading-space variant is a real filename
# some tools write.
review_result.json
 review_result.json
notes.md
*.review.json
PR_TITLE_AND_BODY.json
CHECK_SUMMARY.json
EXIT.json

# Playwright screenshots written by the Tonight trusted-UI specs. The specs
# create the directory themselves and overwrite every file on each run, so a
# committed copy is stale the moment the page changes.
e2e-shots/

# Places enrichment resumable attempts and atomic writes. Published fields live in data/places_enrichment.json.
data/places_verification/enrichment_progress.json
data/places_verification/enrichment_progress.json.tmp
data/places_enrichment.json.tmp
data/places_enrichment_stamp.json.tmp

# Generated from copied Places observations before dev/build; runtime reads only requested OSM files.
data/generated/places_enrichment/
data/places_verification/enrichment_uk_cities_progress.json*
data/places_verification/enrichment_london_extras_progress.json*
data/places_verification/enrichment_uk_cities_extras_progress.json*
data/places_enrichment_uk_cities.json.tmp
data/places_enrichment_london_extras.json.tmp
data/places_enrichment_uk_cities_extras.json.tmp

# A database dump is private data and the repository is public.
*.dump
*.dump.partial
/pubmax-backups/
