# Copy to .env.local (gitignored). All values are server-side only — never
# commit real secrets. Every key below is OPTIONAL: with none set, the app runs
# on an in-memory store + static caches (fine for demo). Set them to turn on
# real persistence and the AI narrator.

# ── Supabase: Pint Drops persistence + photo storage + heritage cache ──
# Without these, Pint Drops live in process memory and reset on restart.
SUPABASE_URL=
# Server-only. NEVER commit a real value — bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pint-drops

# ── The Landlord heritage agent (Claude via OpenRouter) ──
# Without a key, /api/heritage returns grounded, structured-only answers
# (the honest fallback) instead of a narrated reply.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
