# Copy to .env.local (gitignored). Never commit real secrets.
#
# Local development can run without these values: Pint Drops use the in-memory
# demo store and /api/heritage uses the structured fallback. Production is
# different: set the required values below before deploy, or Pint Drop writes
# intentionally return 503 and admin moderation is unavailable.

# ── Required in production: Pint Drops persistence + photo storage ──
SUPABASE_URL=
# Server-only. NEVER commit a real value — bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pint-drops

# ── Required for browser auth + Supabase Realtime in the demo ──
# Public browser values. The publishable key is safe to expose; never put the
# service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Required in production: moderation + durable rate limiting ──
# assertServerEnv() FATALs at route import if either is unset in production.
# RATE_LIMIT_SALT must be a unique secret — not the dev default "pubmax-rate-limit".
ADMIN_TOKEN=
RATE_LIMIT_SALT=

# ── Optional: The Landlord heritage agent (Claude via OpenRouter) ──
# Without a key, /api/heritage returns grounded, structured-only answers
# (the honest fallback) instead of a narrated reply.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# ── Optional: Firecrawl (Wetherspoon directory refresh + research scrapes) ──
# Used by scripts/fetch_wetherspoons_pubs.mjs. Never commit a real key.
# Local copy lives in .env (gitignored). Get a key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=
