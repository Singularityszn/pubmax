# A .vercelignore REPLACES the .gitignore fallback, so anything gitignored and
# absent from this file is uploaded. Keep the two in step: a directory added to
# .gitignore that a build does not need belongs here as well. A CLI deploy
# uploads the working tree, so a TRACKED directory the build never reads is
# uploaded too unless it is named here.
#
# __tests__/vercelIgnoreCoverage.test.ts is the fence: every top-level directory
# over 5 MB is either a deploy input named there with the reason it is one, or
# it appears below.

# Local verification and generated build output are not production inputs.
# `.next` is named on its own line because `/.next-*` does not match it.
# `.vercel` is the CLI's own project link and its local build output: the
# platform excludes it from an upload itself, and it reaches tens of megabytes
# on any machine that has run `npm run deploy:preview`.
/.next
/.next-*
/.vercel/
/coverage/
/__tests__/
/e2e/
/e2e-shots/
/.tmp-evidence/

# Harvest shards and crawler output. Gitignored, large, and read by scripts the
# deployed functions never run.
/data-harvest/
/.firecrawl/

# Agent tooling checkouts. Not inputs to any build. `.gitnexus` is the local code
# graph a developer running that tool builds beside the repo; it reaches a
# gigabyte and no deploy reads a byte of it.
/.agents/
/.cursor/
/.gitnexus/
/.opencode/
/skills/

# Design evidence and handoff documents are kept in GitHub, not deployed.
/docs/

# The native shells are built by Xcode and Gradle, never by the web build, and
# they are the two largest directories in the tree after node_modules.
/ios/
/android/

# The rest of the agent and browser-harness output.
/.claude/
/test-results/
/playwright-report/

# Mission workspace knowledge base and validation screenshots. Local agent
# artifacts (see the mission AGENTS.md), never part of the committed codebase
# or any deploy.
/library/
