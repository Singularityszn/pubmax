# No dependency runs code at install time. `npm ci` skips every preinstall,
# install and postinstall script; scripts/ci/install-script-allowlist.mjs names
# the few that run, and CI runs it straight after `npm ci`.
#
# This also skips pre/post hooks around `npm run <name>`, so package.json has
# none: each script that needs a step first says so in its own command.
ignore-scripts=true
