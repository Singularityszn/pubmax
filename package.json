    "evaluate:open-pubs:london": "node scripts/evaluate_open_pubs.mjs --london",
    "whats-on-refresh": "node scripts/refresh_whats_on.mjs",
    "refresh:area-news": "node scripts/refresh_area_news.mjs",
    "ingest:night-signals": "node scripts/ingest_night_signal_candidates.mjs",
    "refresh:night-signals": "node scripts/refresh_night_signal_claims.mjs",
    "refresh:weather": "node scripts/refresh_weather_snapshots.mjs",
    "push:daily": "node --conditions=react-server --import tsx scripts/push/sendDailyBrief.mjs",
    "push:step-out": "node --conditions=react-server --import tsx scripts/push/sendStepOutNudge.mjs",
    "refresh:events": "node --import tsx scripts/whatson/eventsRefresh.mjs",
    "check:realtime": "node scripts/check-realtime.mjs",
    "verify": "npm run validate-data && npm run lint && npm run db:types:check && npm run typecheck && npm run test:chatgpt-map && npm run deadcode && npm run coverage -- --without-postgres && npm run test:rls && npm run gate:e2e-skips && npm run check:freshness && node scripts/ci/install-script-allowlist.mjs --check && node scripts/resilient-audit.mjs",
    "verify:no-mistakes": "DEPLOYMENT_VERSION=local PUBMAX_VERIFY_COMMITTED_DATA=1 node scripts/run-with-restored-bundled-data.mjs npm run verify",
    "ci": "npm run verify && npm run build",
    "ci:isolated": "node scripts/run-with-restored-next-env.mjs npm run ci",
    "setup": "git config core.hooksPath .githooks && echo 'git hooks enabled (pre-push runs npm run verify)'",
    "merge:london-chains": "node scripts/merge_london_chain_scrapes.mjs",
    "deadcode": "node scripts/deadcode-gate.mjs",
    "deadcode:all": "knip",
    "harvest:run": "tsx scripts/harvest/run.mjs",
    "harvest:uk-pubs": "node --max-old-space-size=2048 scripts/harvest/uk-pubs/run.mjs",
    "harvest:uk-bars": "node --max-old-space-size=2048 scripts/harvest/uk-pubs/run.mjs --bars",
    "harvest:fold": "node --conditions=react-server --import tsx scripts/harvest/uk-pubs/fold.mjs",
    "editorial:poll": "node scripts/editorial/poll.mjs",
    "harvest:pub-website-amenities": "node --conditions=react-server --import tsx scripts/harvest/pub-website-amenities/run.mjs",
    "harvest:pub-website-hours-dogs": "node --conditions=react-server --import tsx scripts/harvest/pub-website-amenities/hours-and-dogs.mjs",
    "harvest:uk-prices": "node --conditions=react-server --import tsx scripts/harvest/uk-prices/run.mjs",
    "build:uk-price-bundle": "tsx scripts/build_uk_price_bundle.mjs",
    "harvest:uk-menu-urls": "tsx scripts/harvest/uk-prices/menu-urls.mjs",
    "harvest:uk-prices-rendered": "tsx scripts/harvest/uk-prices/render.mjs",
    "harvest:uk-prices-ocr": "tsx scripts/harvest/uk-prices/ocr.mjs",
    "build:price-bands": "tsx scripts/build_price_bands.mjs",
    "build:discover-board": "tsx scripts/build_discover_board.mjs",
    "arize:smoke": "tsx scripts/arizeSmoke.ts",
    "backfill:site-harvest-drink-labels": "tsx scripts/backfill_site_harvest_drink_labels.mjs",
    "harvest:soft-drinks-menus": "tsx scripts/harvest_soft_drinks_menus.mjs",
    "discover:soft-drinks-menu-urls": "tsx scripts/discover_soft_drinks_menu_urls.mjs",
    "eval:pal": "node --conditions=react-server --import tsx scripts/pal-eval.mjs",
    "eval:pal:live": "node --conditions=react-server --import tsx scripts/pal-eval.mjs --live --write-scoreboard",
    "eval:ask-router-models": "node --conditions=react-server --import tsx scripts/ask-router-model-eval.mjs",
    "regenerate:pal-answer-key": "node --conditions=react-server --import tsx scripts/regenerate-pal-answer-key.mjs",
    "verify:famous-venues": "node --env-file-if-exists=.env.local --import tsx scripts/verify_famous_venues.mjs",
    "verify:pub-hours": "node --import tsx scripts/verify_pub_hours.mjs",
    "verify:london-places": "node --import tsx scripts/verify_london_places.mjs",
    "build:places-enrichment": "node --import tsx scripts/build_places_enrichment.mjs",
    "enrich:google-places": "node --import tsx scripts/enrich_google_places.mjs",
    "test:chatgpt-map": "npm --prefix scripts/chatgpt-map ci --no-audit --no-fund && npm --prefix scripts/chatgpt-map test",
    "deps:install-scripts": "node scripts/ci/install-script-allowlist.mjs",
    "tavily:nightly": "tsx scripts/tavily-nightly-pass.mjs"
  },
  "allowScripts": {
    "core-js": false,
    "esbuild": true,
    "fsevents": false,
    "unrs-resolver": false
  },
