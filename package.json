{
  "name": "pubmaxxing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "npm run prepare:maplibre-worker",
    "dev": "next dev --webpack",
    "prebuild": "npm run prepare:maplibre-worker && npm run build:slim && npm run build:city-slim && npm run build:pubmaxxing-seed && npm run build:uk-base && npm run build:discover-board",
    "build": "next build",
    "prestart": "node -e \"const d=process.env.NEXT_DIST_DIR||'.next'; require('fs').existsSync(d+'/BUILD_ID') || (console.error('\\n\\u2717 '+d+'/BUILD_ID is missing \\u2014 there is no completed production build to serve.\\n  Run npm run build to completion first. In this shared worktree a concurrent next dev/next build can clobber .next mid-build and leave it partial; for isolated production QA use NEXT_DIST_DIR=.next-prod.\\n'), process.exit(1))\"",
    "start": "next start",
    "deploy:preview": "node scripts/deploy-vercel.mjs",
    "deploy:preview:prod-env": "node scripts/deploy-preview-prod-env.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "node scripts/rls/run-session-tests.mjs",
    "test:e2e": "playwright test",
    "e2e:cli": "playwright cli",
    "perf:cwv-sweep": "PUBMAX_CWV_SWEEP=1 playwright test --project=chromium-cwv",
    "perf:cwv-record": "PUBMAX_CWV_RECORD=1 playwright test --project=chromium-cwv",
    "e2e:seed": "tsx scripts/e2e-seed-user.ts",
    "e2e:teardown": "tsx scripts/e2e-seed-user.ts --teardown",
    "gate:playwright": "node scripts/assert-playwright-gate.mjs",
    "gate:e2e-skips": "node scripts/assert-no-conditional-e2e-skips.mjs e2e",
    "gate:privacy": "node scripts/assert-privacy-response.mjs",
    "shots": "PUBMAX_E2E_KEYLESS=1 PW_SCREENSHOTS=1 PUBMAX_TRACKED_OUTPUTS=docs/screenshots node scripts/run-with-restored-next-env.mjs sh -c 'npm run build && base=$((30000 + ($$ % 10000))); i=0; for p in shots-390-light shots-1440-light shots-390-dark shots-1440-dark; do PW_PORT=$((base + i)) playwright test --workers=1 --project=$p || exit; i=$((i + 1)); done'",
    "shots:extended": "PUBMAX_E2E_KEYLESS=1 PW_SCREENSHOTS=1 PUBMAX_TRACKED_OUTPUTS=docs/screenshots node scripts/run-with-restored-next-env.mjs sh -c 'npm run build && base=$((30000 + ($$ % 10000))); i=0; for p in shots-390-light shots-430-light shots-1280-light shots-1440-light shots-390-dark shots-430-dark shots-1280-dark shots-1440-dark; do PW_PORT=$((base + i)) playwright test --workers=1 --project=$p || exit; i=$((i + 1)); done'",
    "coverage": "vitest run --coverage --maxWorkers=4",
    "prevalidate-data": "npm run build:slim && npm run build:city-slim && npm run build:pubmaxxing-seed && npm run build:uk-base",
    "validate-data": "node scripts/validate-data.mjs",
    "check:freshness": "node scripts/check_freshness.mjs",
    "build:pint-index-snapshot": "node --conditions=react-server --import tsx scripts/build_pint_index_snapshot.mjs",
    "ingest:hyped-pubs": "node scripts/hyped-pubs-ingest.mjs",
    "publish:pint-index-month": "tsx scripts/publish_pint_index_month.mjs",
    "export:data": "python3 scripts/export_app_dataset_json.py",
    "postexport:data": "npm run canonicalize:venues",
    "canonicalize:venues": "node scripts/canonicalize_venue_dataset.mjs",
    "prebuild:slim": "npm run canonicalize:venues",
    "build:slim": "node scripts/build_slim_index.mjs",
    "fetch:city-pubs": "node scripts/fetch_city_osm_pubs.mjs",
    "fetch:city-places": "node scripts/fetch_city_place_nodes.mjs",
    "build:city-night-areas": "node scripts/build_city_night_areas.mjs",
    "fetch:uk-pubs": "node scripts/fetch_uk_osm_pubs.mjs",
    "fetch:uk-venues": "node scripts/fetch_uk_osm_venues.mjs",
    "build:london-venues": "node scripts/build_london_venue_shards.mjs",
    "build:london-desks": "node scripts/build_london_desk_index.mjs",
    "build:price-estimates": "node scripts/build_price_estimate_baselines.mjs",
    "harvest:chain-prices": "tsx scripts/harvest_chain_menu_prices.mjs",
    "fetch:wetherspoons-pubs": "tsx scripts/fetch_wetherspoons_pubs.mjs",
    "fetch:london-pubs": "node scripts/fetch_city_osm_pubs.mjs --london",
    "merge:london-osm": "node scripts/merge_outer_london_osm.mjs",
    "build:city-slim": "node scripts/build_city_slim_index.mjs",
    "build:pubmaxxing-seed": "node scripts/build_pubmaxxing_seed.mjs",
    "build:uk-base": "node scripts/build_uk_base_shards.mjs && node scripts/build_uk_place_index.mjs && node scripts/build_uk_pub_search_index.mjs",
    "build:uk-pub-search": "node scripts/build_uk_pub_search_index.mjs",
    "fetch:wikidata-notable-pubs": "node scripts/fetch_wikidata_notable_pubs.mjs",
    "prepare:maplibre-worker": "node scripts/copy_maplibre_worker.mjs",
    "build:heritage-listings": "node scripts/build_heritage_listings.mjs",
    "pubpal:agent": "node scripts/pubpal/create-elevenlabs-agent.mjs",
    "gen:brand-assets": "node scripts/gen-brand-assets.mjs",
    "gen:store-screenshots": "node scripts/gen-store-screenshots.mjs",
    "ios:build": "node scripts/ios-simulator.mjs",
    "ios:run": "node scripts/ios-simulator.mjs --run",
    "android:build": "node scripts/android/build.mjs",
    "android:run": "node scripts/android/run.mjs",
    "refresh:prices": "node scripts/refresh_prices.mjs",
    "refresh:drink-prices": "node scripts/refresh_drink_prices.mjs",
    "enrich:city": "node scripts/enrich_city_pubs_tavily.mjs",
    "evaluate:open-pubs": "node scripts/evaluate_open_pubs.mjs",
    "evaluate:open-pubs:london": "node scripts/evaluate_open_pubs.mjs --london",
    "whats-on-refresh": "node scripts/refresh_whats_on.mjs",
    "refresh:area-news": "node scripts/refresh_area_news.mjs",
    "ingest:night-signals": "node scripts/ingest_night_signal_candidates.mjs",
    "refresh:night-signals": "node scripts/refresh_night_signal_claims.mjs",
    "refresh:weather": "node scripts/refresh_weather_snapshots.mjs",
    "push:daily": "node --conditions=react-server --import tsx scripts/push/sendDailyBrief.mjs",
    "push:step-out": "node --conditions=react-server --import tsx scripts/push/sendStepOutNudge.mjs",
    "refresh:events": "node scripts/whatson/eventsRefresh.mjs",
    "check:realtime": "node scripts/check-realtime.mjs",
    "verify": "npm run validate-data && npm run lint && npm run typecheck && npm run deadcode && npm run coverage && npm run test:rls && npm run gate:e2e-skips && npm run check:freshness && node scripts/resilient-audit.mjs",
    "ci": "npm run verify && npm run build",
    "ci:isolated": "node scripts/run-with-restored-next-env.mjs npm run ci",
    "setup": "git config core.hooksPath .githooks && echo 'git hooks enabled (pre-push runs npm run verify)'",
    "merge:london-chains": "node scripts/merge_london_chain_scrapes.mjs",
    "deadcode": "knip",
    "harvest:run": "tsx scripts/harvest/run.mjs",
    "harvest:uk-pubs": "node --max-old-space-size=2048 scripts/harvest/uk-pubs/run.mjs",
    "harvest:uk-bars": "node --max-old-space-size=2048 scripts/harvest/uk-pubs/run.mjs --bars",
    "harvest:fold": "node --conditions=react-server --import tsx scripts/harvest/uk-pubs/fold.mjs",
    "editorial:poll": "node scripts/editorial/poll.mjs",
    "harvest:uk-prices": "tsx scripts/harvest/uk-prices/run.mjs",
    "build:uk-price-bundle": "tsx scripts/build_uk_price_bundle.mjs",
    "harvest:uk-menu-urls": "tsx scripts/harvest/uk-prices/menu-urls.mjs",
    "harvest:uk-prices-rendered": "tsx scripts/harvest/uk-prices/render.mjs",
    "harvest:uk-prices-ocr": "tsx scripts/harvest/uk-prices/ocr.mjs",
    "build:price-bands": "tsx scripts/build_price_bands.mjs",
    "build:discover-board": "tsx scripts/build_discover_board.mjs",
    "deadcode:all": "knip --include files,exports,types,duplicates",
    "arize:smoke": "tsx scripts/arizeSmoke.ts"
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.102",
    "@arizeai/openinference-semantic-conventions": "^2.11.0",
    "@arizeai/openinference-vercel": "^3.2.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/text-zoom": "^8.0.1",
    "@clerk/nextjs": "^7.9.2",
    "@elevenlabs/react": "^1.15.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/oidc": "3.8.7",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "context.dev": "2.14.0",
    "convex": "^1.45.0",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "6.9.0",
    "next": "^16.3.5",
    "posthog-js": "^1.430.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@next/env": "^16.3.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "pdfjs-dist": "6.3.289",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "browserslist": "^4.28.7",
    "postcss": "^8.5.23",
    "sharp": "$sharp",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  }
}
