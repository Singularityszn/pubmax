{
  "name": "pubmaxing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "validate-data": "node scripts/validate-data.mjs",
    "export:data": "python3 scripts/export_app_dataset_json.py",
    "build:slim": "node scripts/build_slim_index.mjs",
    "refresh:prices": "node scripts/refresh_prices.mjs",
    "verify": "npm run validate-data && npm run lint && npm run typecheck && npm run coverage",
    "ci": "npm run verify && npm run build",
    "setup": "git config core.hooksPath .githooks && echo 'git hooks enabled (pre-push runs npm run verify)'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.0.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
