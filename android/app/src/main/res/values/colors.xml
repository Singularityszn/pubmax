<?xml version="1.0" encoding="utf-8"?>
<!--
  Two answers share this file.

  The FIRST three are the colour names android/app/src/main/res/values/styles.xml
  has always referenced. Without them they resolve to the ones Capacitor's own
  library ships: Material indigo #3F51B5 / #303F9F and pink #FF4081. Those are
  not decoration - they paint the recents-screen task card and the text
  selection handles inside the WebView, so a reviewer swiping the task switcher
  saw indigo chrome around an ink-and-coral app.

  Their values are the brand tokens named in docs/BRAND_MARK.md and held in
  lib/brandMark.mjs BRAND_COLORS, which is the master every icon and share card
  is cut from. __tests__/nativeWrap.test.ts reads them out of that module and
  compares, so the two cannot drift apart in silence.

  The token names below are written without their CSS prefix on purpose: XML
  forbids a double hyphen inside a comment and aapt fails the whole build for
  one, which is how this file first turned the Android build red.
-->
<resources>
    <!-- ink-deep: the dark field the app's own chrome sits on. -->
    <color name="colorPrimary">#060607</color>
    <color name="colorPrimaryDark">#060607</color>
    <!-- brass: the coral accent. -->
    <color name="colorAccent">#ff5a5f</color>
    <!-- The accent Android paints behind a notification's small icon and uses
         for its app name line. It is the brand coral, and it is stated here
         because AndroidManifest.xml can only name a resource. Kept equal to
         BRAND_COLORS.coral in lib/brandMark.mjs by
         __tests__/androidNotificationIcon.test.ts, so the two halves of one
         colour cannot drift a file apart. -->
    <color name="pubmaxx_notification_accent">#FF5A5F</color>
    <!-- The window behind the WebView. On a WebView older than the version
         Capacitor trusts to report safe areas (SystemBars.java,
         WEBVIEW_VERSION_WITH_SAFE_AREA_FIX) the WebView is inset from the
         system bars and this colour is the band under the clock; the theme's
         own default painted it white over an off-white page, which read as a
         browser's chrome. It is the page's paper token, with the dark paper in
         values-night, so the band is the page whichever way the phone reads.
         paper: the page paper token, the body remap in app/globals.css. -->
    <color name="pubmaxx_window_background">#F8F2EC</color>
    <!-- Explicit page choices must work independently of Android night mode. -->
    <color name="pubmaxx_page_light">#F8F2EC</color>
    <color name="pubmaxx_page_dark">#0A0A0B</color>
</resources>
