<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PHONES ONLY FOR v1, the same decision as iOS's TARGETED_DEVICE_FAMILY = 1
         (7 September 2026): above 640px the page crosses into the desktop
         layout, which no rig in the shell has tested, so the Play listing is
         filtered to phone screen sizes until a tablet release with its own
         layout pass and 7- and 10-inch screenshots. This is the documented
         Play filter; it takes the listing off tablets and large foldables and
         nothing else. -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="false"
        android:xlargeScreens="false" />

    <!-- Declaring the CAMERA permission implicitly declares that the device
         MUST have a camera, and Play then hides the listing from every device
         without one. A pub map is worth having on a tablet with no camera, so
         the requirement is stated as optional and the seam already treats a
         refused capture as "nothing chosen". -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android Auto Backup copies the app's data, WebView localStorage
         included, to the person's Google Drive, and it is ON by default. This
         app keeps the browser session in evictable localStorage
         (lib/authSessionResume.ts) and a refresh token per account beside it
         (lib/deviceAccountSessions.ts), so the default would put live
         credentials in a third-party cloud - a data practice
         app/privacy/page.tsx does not describe and the Play Data safety form
         does not declare. Refusing backup is the honest answer rather than the
         narrow one: everything this app holds on a device is a signed-in
         session and a city choice, and both are cheap to re-establish. The
         same attribute governs Android 12+ device-to-device transfer, so one
         line closes both doors and no extraction-rules file is needed. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Request Android App Link verification for each supported route.
                 It becomes verified after assetlinks.json carries the owner's
                 release signing fingerprint. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/plan/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/rounds/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/p/" />
            </intent-filter>
            <!-- A shared pin is /map?sel=<venueId>: the pub rides the query, so
                 the path itself is exact. /map/<city> is the separate prefix
                 below. Both mirror lib/nativeDeepLinks.ts. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:path="/map" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/map/" />
            </intent-filter>
            <!-- Venue and pub permalinks redirect server-side onto /map?sel=,
                 so they open the pin rather than a second pub page. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/venue/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/pub/" />
            </intent-filter>
            <!-- The two links a person hands to somebody else, and the night
                 a push already opens. All three mirror lib/nativeDeepLinks.ts.
                 /r/ is a redirect onto the home page's referral fragment, and
                 the app is handed the link that was shared rather than the
                 redirect's target, so the family is declared as shared. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/add/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:pathPrefix="/r/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:path="/tonight" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pubmaxxing.com" android:path="/auth/callback" />
            </intent-filter>
            <!-- The pubmaxx:// scheme, the FALLBACK beside the verified links
                 above. It is never autoVerify: verification belongs to https,
                 and App Links need the real signing fingerprint in
                 assetlinks.json. The families it opens, and the sign-in return
                 it refuses, are lib/nativeDeepLinks.ts's own. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pubmaxx" />
            </intent-filter>
        </activity>

        <!-- Android renders a notification's small icon as a SILHOUETTE of its
             alpha channel. With no icon named here FCM falls back to the
             launcher icon, which is a full-colour adaptive icon, so every push
             the app ever sends arrives as a white blob in the status bar. The
             drawable is cut from the one mark master and generated by
             scripts/gen-native-app-icons.mjs. The colour is what Android tints
             the icon and the app-name line with. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_pubmaxx" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/pubmaxx_notification_accent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The camera. iOS asks for this in words (NSCameraUsageDescription) and
         Android asks for it here, so the two halves of ONE promise were a file
         apart and only one of them was written down: an Android build with no
         CAMERA line answers every capture attempt with a silent refusal. That
         covers all three paths at once - the Capacitor seam
         (lib/nativeCamera.ts), the `capture` inputs the WebView chooser opens,
         and the media read a chosen photo needs. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Reading the photo a person picked. Android 13 split the old storage
         permission per medium, so BOTH lines are needed to cover the range the
         app supports (minSdk 24): the scoped one from 33 up, the legacy one
         capped below it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13 made notifications a runtime permission. Undeclared, the
         request lib/nativePush.ts makes cannot be granted and registration
         fails silently on every modern device: no dialog, no token, no error a
         reader would ever see. Declaring it does not ask for anything - the
         contextual explainer (lib/nativePushPrompt.ts) is still the only thing
         that triggers the OS dialog, and only after a kept action. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
