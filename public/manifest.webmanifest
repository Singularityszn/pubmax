{
  "name": "PUBMAXX",
  "short_name": "PUBMAXX",
  "description": "Price-aware nightlife map, planner, and stories worth remembering.",
  "start_url": "/tonight",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#fff8f4",
  "theme_color": "#16122a",
  "shortcuts": [
    {
      "name": "Open Shared Pub",
      "short_name": "Share",
      "description": "Send a pub or place into PUBMAXX.",
      "url": "/share?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tonight",
      "short_name": "Tonight",
      "description": "Open the live tonight surface.",
      "url": "/tonight?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Map",
      "short_name": "Map",
      "description": "Find nearby pubs and prices.",
      "url": "/map?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Plan Crawl",
      "short_name": "Plan",
      "description": "Start a pub crawl plan.",
      "url": "/plan?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
