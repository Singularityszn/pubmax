{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".agents/**",
    "skills/**",
    ".claude/**"
  ],
  "rules": {
    "files": "off",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "unresolved": "off",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "off",
    "unlisted": "error",
    "binaries": "error"
  },
  "ignoreDependencies": [
    "postcss",
    "playwright"
  ]
}
