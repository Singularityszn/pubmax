+    expect(selectedDrinkPriceDescription(evidence)).toContain(
+      "Serving size not recorded",
+    );
+  });
+
+  it.each([
+    { ...listed, sourceUrl: "javascript:alert(1)" },
+    { ...listed, sourceUrl: "https://example.org/me\nnu" },
