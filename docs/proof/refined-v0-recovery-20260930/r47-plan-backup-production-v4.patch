+  v_status text;
+  v_context jsonb;
+  v_current_unresolved jsonb;
+  v_stop_count integer;
+begin
+  if public._social_plan_is_bound(p_plan_id) then return 'not_found'; end if;
+  if p_decision not in ('accepted', 'rejected') then return 'invalid'; end if;
