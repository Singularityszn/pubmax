<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>PUBMAXXING</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- The pubmaxx:// scheme, the FALLBACK beside universal links. Those are
	     declared in App.entitlements and only verify on a signed build; this
	     opens on any build, so `xcrun simctl openurl` can reach the app. The
	     families it opens, and the sign-in return it refuses, are
	     lib/nativeDeepLinks.ts's own (NATIVE_URL_SCHEME). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pubmaxx.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pubmaxx</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance. The app ships no encryption of its own: every
	     byte it sends goes over HTTPS, which is the exempt case Apple
	     names. Without this key App Store Connect marks EVERY uploaded
	     build "Missing Compliance" and holds it out of TestFlight and
	     review until somebody answers the question by hand, per upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>PUBMAXXING uses the camera so you can photograph a price board, a pub, or your own night.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PUBMAXXING uses your location while the app is open to find nearby pubs and calculate walk times.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pub Pal uses your microphone when you start a voice chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PUBMAXXING opens your photo library so you can choose a photo you have already taken.</string>
	<!-- The UIScene lifecycle. iOS 27 crashes at launch (EXC_BREAKPOINT in
	     UIKitCore, NoSceneLifecycleAdoption) for an app without this manifest.
	     One scene, built from Main.storyboard and driven by SceneDelegate.swift.
	     The shape is Capacitor 8.5's own (`npx cap migrate`). The app is
	     iPhone only with a single window, so multiple scenes stay off. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- The launch screen is the Info.plist kind Apple has offered since iOS
	     14, not a storyboard: the iOS 26 runtime drew LaunchScreen.storyboard
	     as a plain black frame whatever it held, image or colour alike
	     (docs/proof/mobile-app-design/ios-sim-iphone17pro/launch/). Both
	     names below are asset-catalog entries scripts/gen-native-app-icons.mjs
	     cuts from the one splash master, so the field and the mark cannot
	     drift from every other splash. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Capacitor template leftover: `armv7` is a 32-bit capability, and iOS
	     has been 64-bit only since iOS 11. It named a device class this app
	     cannot ship to. arm64 is the platform it actually requires. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- iPhone is PORTRAIT ONLY, and public/manifest.webmanifest already said
	     so ("orientation": "portrait-primary"). The two halves disagreed, and
	     the plist was the half a reviewer acts on. Rotated to 844x390 the app
	     crosses into the DESKTOP layout: the desktop nav bar and the desktop map
	     toolbar take roughly 55% of the height, and the phone sheet shell does
	     not mount at all (sheetsEnabled, components/mobile/MobileMapShell.tsx),
	     so tapping a pin behaves differently from portrait. Deleting a whole
	     untested layout class is the honest fix. There is no iPad orientation key because
	     v1 is iPhone only (TARGETED_DEVICE_FAMILY = 1, firstmate decision of
	     7 September 2026): iPad is a later release with its own layout pass and
	     13-inch screenshots, and a universal binary would have made App Store
	     Connect demand those and reviewers open the untested class. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
